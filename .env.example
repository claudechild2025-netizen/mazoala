# Database Connections (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/mazoala
DATABASE_MIGRATION_URL=postgresql://postgres:postgres_password@localhost:5432/mazoala

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
APP_BASE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Ulaanbaatar
PORT=3000

# Object Storage (S3-compatible / Supabase Storage)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=ap-east-1
OBJECT_STORAGE_BUCKET=mazoala-exports
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Worker Settings
WORKER_LEASE_SECONDS=60
WORKER_POLL_INTERVAL_MS=3000
REPORT_SCHEDULER_ENABLED=false
