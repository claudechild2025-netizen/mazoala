{
  "name": "mazoala-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" --filter=\"./apps/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:admin": "pnpm --filter=@mazoala/admin dev",
    "dev:worker": "pnpm --filter=@mazoala/worker dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "xlsx": "^0.18.5"
  }
}
